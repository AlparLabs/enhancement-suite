<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_producttemplatelabel3x8">
        <t t-call="web.basic_layout">
            <div class="page">
                <t t-set="columns" t-value="3"/>
                <t t-set="rows" t-value="8"/>
                <t t-set="price_included" t-value="True"/>
                <t t-call="product.report_productlabel"/>
            </div>
        </t>
    </template>

    <template id="report_productlabel_add_3x8" inherit_id="product.report_productlabel">
        <xpath expr="//t[contains(@t-if, 'columns == 4 and rows == 12')]" position="after">
            <t t-if="columns == 3 and rows == 8">
                <t t-set="padding_page" t-value="'padding: 12mm 9mm'"/>
                <t t-set="report_to_call" t-value="'3x8'"/>
            </t>
        </xpath>
        <xpath expr="//t[contains(@t-elif, '4x12')]" position="after">
            <t t-elif="report_to_call == '3x8'">
                <t t-call="product_label_3x8.report_simple_label3x8"/>
            </t>
        </xpath>
    </template>

    <template id="report_simple_label3x8">
        <t t-set="barcode_size" t-value="'width:45mm;height:12mm'"/>
        <t t-set="table_style" t-value="'width:63mm;height:33mm;' + table_style"/>
        <td t-att-style="make_invisible and 'visibility:hidden;'">
            <div class="o_label_full" t-att-style="table_style">
                <div class="o_label_name">
                    <strong t-field="product.display_name"/>
                </div>
                <div class="text-end" style="padding-top:0;padding-bottom:0">
                    <strong class="o_label_price_medium"
                            t-out="pricelist._get_product_price(product, 1, currency=pricelist.currency_id or product.currency_id)"
                            t-options="{'widget': 'monetary', 'display_currency': pricelist.currency_id or product.currency_id, 'label_price': True}"/>
                </div>
                <div class="text-center o_label_small_barcode">
                    <span class="text-nowrap" t-field="product.default_code"/>
                    <t t-if="barcode">
                        <div t-out="barcode" style="padding:0" t-options="{'widget': 'barcode', 'symbology': 'auto', 'img_style': barcode_size}"/>
                        <span class="text-center" t-out="barcode"/>
                    </t>
                </div>
            </div>
        </td>
    </template>
</odoo>
