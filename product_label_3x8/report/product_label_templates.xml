<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_producttemplatelabel3x8">
        <t t-call="web.basic_layout">
            <div class="page">
                <t t-set="columns" t-value="3"/>
                <t t-set="rows" t-value="8"/>
                <t t-set="price_included" t-value="True"/>
                <t t-call="product.report_productlabel"/>
            </div>
        </t>
    </template>

    <template id="report_productlabel_add_3x8" inherit_id="product.report_productlabel">
        <xpath expr="//t[contains(@t-if, 'columns == 4 and rows == 12')]" position="after">
            <t t-if="columns == 3 and rows == 8">
                <t t-set="padding_page" t-value="'padding: 12mm 9mm'"/>
                <t t-set="report_to_call" t-value="'3x8'"/>
            </t>
        </xpath>
        <xpath expr="//t[contains(@t-elif, '4x12')]" position="after">
            <t t-elif="report_to_call == '3x8'">
                <t t-call="product_label_3x8.report_simple_label3x8"/>
            </t>
        </xpath>
    </template>

    <template id="report_simple_label3x8">
        <t t-set="table_style" t-value="'width:63mm;height:33mm;box-sizing:border-box;overflow:hidden;padding:0;margin:0 auto;' + table_style"/>
        <t t-set="info" t-value="get_label_info(product, pricelist) if get_label_info else False"/>
        <td t-att-style="make_invisible and 'visibility:hidden;'">
            <div class="o_label_full" t-att-style="table_style">
                <table style="width:100%; height:33mm; border-collapse:collapse; border:none; margin:0; padding:0;">
                    <tr>
                        <!-- Columna Izquierda (54%): Nombre arriba + Precios, Promoción y PUM abajo (donde antes estaba el barcode) -->
                        <td style="width:54%; height:33mm; vertical-align:top; padding:1.5mm 1mm 1.2mm 2mm; box-sizing:border-box;">
                            <table style="width:100%; height:30.3mm; border-collapse:collapse; border:none; margin:0; padding:0;">
                                <!-- Fila Superior: Nombre del producto -->
                                <tr t-attf-style="height:#{info and info.get('is_promo_active') and '11mm' or '14mm'};">
                                    <td style="vertical-align:top; padding:0;">
                                        <div t-attf-style="font-size:7.2pt; font-weight:800; line-height:1.12; max-height:#{info and info.get('is_promo_active') and '11mm' or '14mm'}; overflow:hidden; text-overflow:ellipsis; display:-webkit-box; -webkit-line-clamp:#{info and info.get('is_promo_active') and '3' or '4'}; -webkit-box-orient:vertical; text-transform:uppercase; color:#111; word-break:break-word;">
                                            <strong t-field="product.display_name"/>
                                        </div>
                                    </td>
                                </tr>
                                <!-- Fila Inferior (espacio del código de barras): Precios, Promoción / Descuento y P.U.M. -->
                                <tr>
                                    <td style="vertical-align:bottom; padding:0;">
                                        <!-- 1. Badge de Promoción si aplica -->
                                        <t t-if="info and info.get('is_promo_active') and info.get('discount_label')">
                                            <div style="display:inline-block; background-color:#111; color:#fff; font-size:5.8pt; font-weight:900; padding:1px 4px; border-radius:2px; letter-spacing:0.5px; margin-bottom:0.4mm; line-height:1.2;">
                                                OFERTA <t t-out="info['discount_label']"/>
                                            </div>
                                        </t>
                                        <!-- 2. Precio de Venta (en oferta es el precio de promoción) -->
                                        <strong t-attf-style="font-size: #{info and info.get('price_font_size', '16pt') or '16pt'}; font-weight: 900; line-height: 0.92; white-space: nowrap; color: #000; letter-spacing: -0.5px; display: block;"
                                                t-out="info and info['price_final'] or pricelist._get_product_price(product, 1, currency=pricelist.currency_id or product.currency_id)"
                                                t-options="{'widget': 'monetary', 'display_currency': info and info['currency'] or (pricelist.currency_id or product.currency_id), 'label_price': True}"/>
                                        <!-- 3. Precio Anterior tachado si aplica promoción -->
                                        <t t-if="info and info.get('is_promo_active') and info.get('price_before')">
                                            <div style="font-size:5.8pt; color:#666; line-height:1; margin-top:0.3mm;">
                                                Antes: <span style="text-decoration:line-through; font-weight:600;"
                                                             t-out="info['price_before']"
                                                             t-options="{'widget': 'monetary', 'display_currency': info['currency']}"/>
                                            </div>
                                        </t>
                                        <!-- 4. Bloque Fiscal y P.U.M. -->
                                        <div style="margin-top: 0.4mm;">
                                            <div style="font-size:5pt; color:#555; white-space:nowrap; line-height:1;">
                                                Sin Imp. Nac: <span t-out="info and info['price_net'] or (pricelist._get_product_price(product, 1, currency=pricelist.currency_id or product.currency_id) / 1.21)"
                                                                    t-options="{'widget': 'monetary', 'display_currency': info and info['currency'] or (pricelist.currency_id or product.currency_id)}"/>
                                            </div>
                                            <t t-if="info and info['pum_price']">
                                                <div style="font-size:6.5pt; font-weight:800; color:#000; white-space:nowrap; line-height:1.15;">
                                                    P.U.M.: <span t-out="info['pum_price']" t-options="{'widget': 'monetary', 'display_currency': info['currency']}"/> / <t t-out="info['pum_unit']"/>
                                                </div>
                                            </t>
                                        </div>
                                    </td>
                                </tr>
                            </table>
                        </td>
                        <!-- Columna Derecha (46%): Código de barras a la derecha del producto + Fecha abajo a la derecha -->
                        <td style="width:46%; height:33mm; vertical-align:top; padding:1.5mm 2mm 1.2mm 1mm; text-align:right; box-sizing:border-box;">
                            <table style="width:100%; height:30.3mm; border-collapse:collapse; border:none; margin:0; padding:0;">
                                <!-- Fila Superior: Código de barras a la derecha del producto -->
                                <tr>
                                    <td style="vertical-align:top; text-align:right; padding:0;">
                                        <t t-if="product.default_code">
                                            <div style="font-size:5pt; color:#666; line-height:1; margin-bottom:0.5mm; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; max-width:28mm; text-align:center; margin-left:auto;" t-field="product.default_code"/>
                                        </t>
                                        <t t-if="barcode">
                                            <div style="display:inline-block; text-align:center;">
                                                <div t-out="barcode" style="padding:0; margin:0; line-height:1;" t-options="{'widget': 'barcode', 'symbology': 'auto', 'img_style': 'width:28mm;height:7.2mm'}"/>
                                                <div style="font-size:5pt; text-align:center; line-height:1; letter-spacing:0.5px; width:28mm; color:#333;" t-out="barcode"/>
                                            </div>
                                        </t>
                                    </td>
                                </tr>
                                <!-- Fila Inferior: Fecha de emisión abajo a la derecha -->
                                <tr style="height:3.5mm;">
                                    <td style="vertical-align:bottom; text-align:right; padding:0;">
                                        <span style="font-size:4.8pt; color:#666; white-space:nowrap; line-height:1;">
                                            [<t t-out="info and info['origin'] or 'ARG'"/>] <t t-out="info and info['print_date'] or ''"/>
                                        </span>
                                    </td>
                                </tr>
                            </table>
                        </td>
                    </tr>
                </table>
            </div>
        </td>
    </template>
</odoo>
