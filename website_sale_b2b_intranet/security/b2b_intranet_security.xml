<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- Regla de Reclamos para Portal: Solo puede ver reclamos de su cuenta comercial -->
        <record id="b2b_order_claim_portal_rule" model="ir.rule">
            <field name="name">Portal B2B Order Claim Rule</field>
            <field name="model_id" ref="model_b2b_order_claim"/>
            <field name="domain_force">[('commercial_partner_id', '=', user.partner_id.commercial_partner_id.id)]</field>
            <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <!-- Regla de Reclamos para Usuarios Internos -->
        <record id="b2b_order_claim_user_rule" model="ir.rule">
            <field name="name">Internal User B2B Order Claim Rule</field>
            <field name="model_id" ref="model_b2b_order_claim"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>

        <!-- Regla Multi-Compañía para Reclamos -->
        <record id="b2b_order_claim_company_rule" model="ir.rule">
            <field name="name">Multi-Company B2B Order Claim Rule</field>
            <field name="model_id" ref="model_b2b_order_claim"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        </record>

        <!-- Regla de Materiales POP para Portal -->
        <record id="b2b_marketing_material_portal_rule" model="ir.rule">
            <field name="name">Portal B2B Marketing Material Rule</field>
            <field name="model_id" ref="model_b2b_marketing_material"/>
            <field name="domain_force">[('active', '=', True)]</field>
            <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

    </data>
</odoo>
