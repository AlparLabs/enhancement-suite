<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Vista de Lista para Materiales de Marketing B2B -->
    <record id="view_b2b_marketing_material_list" model="ir.ui.view">
        <field name="name">b2b.marketing.material.list</field>
        <field name="model">b2b.marketing.material</field>
        <field name="arch" type="xml">
            <list string="Materiales POP y Marketing B2B" default_order="sequence, id desc">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="category" widget="badge"/>
                <field name="website_ids" widget="many2many_tags"/>
                <field name="file_name"/>
                <field name="file_ext_display" string="Formato"/>
                <field name="file_size_display" string="Tamaño"/>
                <field name="date_published"/>
                <field name="download_count"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <!-- Vista de Formulario para Materiales de Marketing B2B -->
    <record id="view_b2b_marketing_material_form" model="ir.ui.view">
        <field name="name">b2b.marketing.material.form</field>
        <field name="model">b2b.marketing.material</field>
        <field name="arch" type="xml">
            <form string="Material POP / Marketing B2B">
                <sheet>
                    <widget name="web_ribbon" title="Archivado" bg_color="text-bg-danger" invisible="active"/>
                    <div class="oe_title">
                        <label for="name" string="Título del Documento o Pieza Gráfica"/>
                        <h1>
                            <field name="name" placeholder="Ej: Manual de Marca 2026 / Afiche Promo Primavera"/>
                        </h1>
                    </div>
                    <group>
                        <group name="meta_info" string="Clasificación y Publicación">
                            <field name="category"/>
                            <field name="date_published"/>
                            <field name="website_ids" widget="many2many_tags" placeholder="Todos los canales B2B si está vacío"/>
                            <field name="sequence"/>
                            <field name="active" invisible="1"/>
                        </group>
                        <group name="file_info" string="Archivo Descargable">
                            <field name="file" filename="file_name" widget="binary"/>
                            <field name="file_name"/>
                            <field name="file_ext_display" readonly="1"/>
                            <field name="file_size_display" readonly="1"/>
                            <field name="download_count" readonly="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Descripción / Guía de Aplicación" name="description_page">
                            <field name="description" placeholder="Detalle instrucciones de uso para el franquiciado, medidas sugeridas de impresión, especificaciones técnicas o vigencia..."/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Vista de Búsqueda y Filtros -->
    <record id="view_b2b_marketing_material_search" model="ir.ui.view">
        <field name="name">b2b.marketing.material.search</field>
        <field name="model">b2b.marketing.material</field>
        <field name="arch" type="xml">
            <search string="Buscar Materiales">
                <field name="name"/>
                <field name="file_name"/>
                <field name="description"/>
                <separator/>
                <filter string="Manuales y Protocolos" name="filter_manual" domain="[('category', '=', 'manual')]"/>
                <filter string="Material Gráfico y POP" name="filter_promo" domain="[('category', '=', 'promo')]"/>
                <filter string="Precios Sugeridos" name="filter_pricing" domain="[('category', '=', 'pricing')]"/>
                <filter string="Recetas y Cafetería" name="filter_recipe" domain="[('category', '=', 'recipe')]"/>
                <separator/>
                <filter string="Archivados" name="inactive" domain="[('active', '=', False)]"/>
                <group expand="0" string="Agrupar por">
                    <filter string="Categoría" name="group_by_category" context="{'group_by': 'category'}"/>
                    <filter string="Fecha de Publicación" name="group_by_date" context="{'group_by': 'date_published'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Acción de Ventana -->
    <record id="action_b2b_marketing_material" model="ir.actions.act_window">
        <field name="name">Materiales POP y Marketing B2B</field>
        <field name="res_model">b2b.marketing.material</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_b2b_marketing_material_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Carga el primer material o manual para la red de franquicias y distribuidores.
            </p>
            <p>
                Los franquiciados podrán visualizar y descargar piezas gráficas de alta resolución, listas de precios y manuales oficiales desde el portal.
            </p>
        </field>
    </record>

    <!-- Menú en Ventas > Pedidos -->
    <menuitem id="menu_b2b_marketing_material"
              name="Materiales POP / Marketing B2B"
              parent="sale.sale_order_menu"
              action="action_b2b_marketing_material"
              sequence="45"/>

</odoo>
