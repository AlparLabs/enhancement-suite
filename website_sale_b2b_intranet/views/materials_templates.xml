<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="portal_my_materials" name="B2B Marketing Materials Portal">
        <t t-call="portal.portal_layout">
            <div class="container py-4">

                <!-- Encabezado de la Sección -->
                <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 pb-2 border-bottom">
                    <div>
                        <h2 class="fw-bold mb-1 text-primary">
                            <i class="fa fa-bullhorn me-2"/>Materiales POP y Marketing B2B
                        </h2>
                        <p class="text-muted mb-0">
                            Descarga piezas gráficas de alta definición, manuales operativos y listas oficiales de precios sugeridos.
                        </p>
                    </div>
                    <div class="mt-2 mt-md-0">
                        <a href="/my" class="btn btn-outline-secondary btn-sm">
                            <i class="fa fa-arrow-left me-1"/> Volver a Mi Cuenta
                        </a>
                    </div>
                </div>

                <!-- Barra de Filtros y Búsqueda -->
                <div class="row g-3 mb-4 align-items-center">
                    <!-- Pestañas por Categoría -->
                    <div class="col-lg-8">
                        <div class="d-flex flex-wrap gap-2">
                            <a t-attf-href="/my/materials#{('?search=' + search_term) if search_term else ''}"
                               t-attf-class="btn btn-sm #{'btn-primary' if not selected_category else 'btn-outline-secondary'}">
                                Todos <span class="badge text-bg-light ms-1"><t t-out="total_materials"/></span>
                            </a>
                            <t t-foreach="categories.items()" t-as="cat">
                                <a t-attf-href="/my/materials?category=#{cat[0]}#{('&amp;search=' + search_term) if search_term else ''}"
                                   t-attf-class="btn btn-sm #{'btn-primary' if selected_category == cat[0] else 'btn-outline-secondary'}">
                                    <t t-out="cat[1]"/>
                                    <span class="badge text-bg-light ms-1">
                                        <t t-out="category_counts.get(cat[0], 0)"/>
                                    </span>
                                </a>
                            </t>
                        </div>
                    </div>

                    <!-- Buscador -->
                    <div class="col-lg-4">
                        <form method="get" action="/my/materials" class="d-flex">
                            <t t-if="selected_category">
                                <input type="hidden" name="category" t-att-value="selected_category"/>
                            </t>
                            <input type="text" name="search" class="form-control form-control-sm me-2" placeholder="Buscar material o manual..." t-att-value="search_term"/>
                            <button type="submit" class="btn btn-sm btn-outline-primary">
                                <i class="fa fa-search"/>
                            </button>
                        </form>
                    </div>
                </div>

                <!-- Grilla de Materiales -->
                <t t-if="materials">
                    <div class="row g-4">
                        <t t-foreach="materials" t-as="mat">
                            <div class="col-md-6 col-lg-4">
                                <div class="card h-100 shadow-sm border-0 bg-white">
                                    <div class="card-body d-flex flex-column p-4">
                                        <div class="d-flex justify-content-between align-items-start mb-3">
                                            <span class="badge text-bg-light border text-uppercase fs-7">
                                                <t t-if="mat.category == 'manual'">
                                                    <i class="fa fa-book text-primary me-1"/> Manual
                                                </t>
                                                <t t-elif="mat.category == 'promo'">
                                                    <i class="fa fa-picture-o text-success me-1"/> POP / Gráfica
                                                </t>
                                                <t t-elif="mat.category == 'pricing'">
                                                    <i class="fa fa-tags text-warning me-1"/> Precios
                                                </t>
                                                <t t-else="">
                                                    <i class="fa fa-coffee text-danger me-1"/> Cafetería
                                                </t>
                                            </span>
                                            <div class="d-flex gap-1">
                                                <span t-if="mat.file_ext_display" class="badge text-bg-secondary">
                                                    <t t-out="mat.file_ext_display"/>
                                                </span>
                                                <span t-if="mat.file_size_display" class="badge text-bg-light border text-muted">
                                                    <t t-out="mat.file_size_display"/>
                                                </span>
                                            </div>
                                        </div>

                                        <h5 class="card-title fw-bold text-dark mb-2">
                                            <t t-out="mat.name"/>
                                        </h5>

                                        <p t-if="mat.description" class="card-text text-muted small flex-grow-1 mb-3">
                                            <t t-out="mat.description"/>
                                        </p>
                                        <p t-else="" class="card-text text-muted small fst-italic flex-grow-1 mb-3">
                                            Material oficial de la marca EntreDos para distribución y franquicias.
                                        </p>

                                        <div class="pt-2 border-top mt-auto">
                                            <div class="d-flex justify-content-between align-items-center mb-3 text-muted small">
                                                <span>
                                                    <i class="fa fa-calendar-o me-1"/>
                                                    <span t-field="mat.date_published" t-options="{'widget': 'date'}"/>
                                                </span>
                                                <span t-if="mat.download_count &gt; 0" class="text-muted">
                                                    <i class="fa fa-download me-1"/> <t t-out="mat.download_count"/> descargas
                                                </span>
                                            </div>

                                            <a t-attf-href="/my/materials/#{mat.id}/download" class="btn btn-primary btn-sm w-100 shadow-sm fw-bold">
                                                <i class="fa fa-download me-1"/> Descargar Archivo
                                            </a>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </t>
                    </div>
                </t>

                <!-- Estado Vacío -->
                <t t-else="">
                    <div class="card shadow-sm border-0 text-center py-5">
                        <div class="card-body">
                            <i class="fa fa-folder-open-o fa-4x text-muted mb-3"/>
                            <h4 class="fw-bold text-dark mb-2">No se encontraron materiales</h4>
                            <p class="text-muted mb-3">
                                No hay documentos o piezas de marketing disponibles para el criterio seleccionado.
                            </p>
                            <a href="/my/materials" class="btn btn-outline-primary btn-sm">
                                <i class="fa fa-refresh me-1"/> Ver todos los materiales
                            </a>
                        </div>
                    </div>
                </t>

            </div>
        </t>
    </template>

</odoo>
