<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        Extensión de la vista de formulario de res.partner para mostrar
        el campo 'supervisor_id' junto al crédito del cliente.

        NOTA: En Odoo 18, `credit_limit` está en `account.res_partner_view_form`
        (hereda de base.view_partner_form), dentro de la pestaña Sales & Purchase.
        Si el XPath no encuentra credit_limit (versiones con distinta estructura),
        el segundo record agrega un grupo propio en la misma pestaña.
    -->

    <!-- Opción A: Insertar supervisor_id junto a credit_limit -->
    <record id="view_partner_form_credit_supervisor" model="ir.ui.view">
        <field name="name">res.partner.form.credit.supervisor</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="account.res_partner_view_form"/>
        <field name="arch" type="xml">

            <xpath expr="//field[@name='credit_limit']" position="after">
                <field
                    name="supervisor_id"
                    string="Supervisor de Crédito"
                    options="{'no_create': True}"
                />
            </xpath>

        </field>
    </record>

</odoo>
