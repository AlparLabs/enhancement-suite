<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_form_convert_receipt" model="ir.ui.view">
        <field name="name">account.move.form.convert.receipt</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_convert_to_internal_receipt" 
                        string="Convertir a Recibo Interno" 
                        type="object" 
                        class="btn-secondary"
                        invisible="state != 'draft' or move_type not in ('out_invoice', 'in_invoice')"/>
            </xpath>
        </field>
    </record>
</odoo>