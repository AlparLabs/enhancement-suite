<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_form_convert_receipt" model="ir.ui.view">
        <field name="name">account.move.form.convert.receipt</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_convert_to_internal_receipt" 
                        string="Convertir a Recibo Interno" 
                        type="object" 
                        class="btn-secondary"
                        invisible="state != 'draft' or move_type not in ('out_invoice', 'in_invoice', 'out_receipt', 'in_receipt')"/>
            </xpath>
        </field>
    </record>

    <record id="action_convert_to_internal_receipt_server" model="ir.actions.server">
        <field name="name">Convertir a Recibo Interno</field>
        <field name="model_id" ref="account.model_account_move"/>
        <field name="binding_model_id" ref="account.model_account_move"/>
        <field name="binding_view_types">list</field>
        <field name="state">code</field>
        <field name="code">
            if records:
                records.action_convert_to_internal_receipt()
        </field>
    </record>
</odoo>