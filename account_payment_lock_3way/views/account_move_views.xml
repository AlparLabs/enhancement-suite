<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_move_form_inherit_payment_lock" model="ir.ui.view">
            <field name="name">account.move.form.payment.lock</field>
            <field name="model">account.move</field>
            <field name="inherit_id" ref="account.view_move_form"/>
            <field name="arch" type="xml">

                <xpath expr="//header" position="after">
                    <div class="alert alert-danger" role="alert" style="margin-bottom: 10px;"
                         invisible="move_type != 'in_invoice' or x_discrepancy_state != 'discrepancy' or x_force_payment_approved == True">
                        <div class="d-flex align-items-center">
                            <i class="fa fa-exclamation-triangle fa-2x me-3" title="Alerta de Discrepancia"/>
                            <div>
                                <strong>¡ATENCIÓN! Bloqueo de 3-Way Match</strong><br/>
                                El precio o la cantidad facturada no coinciden con la Orden de Compra.
                                <br/>
                                <em>Vea las líneas resaltadas en rojo abajo. Se requiere Nota de Crédito o Aprobación.</em>
                            </div>
                        </div>
                    </div>
                </xpath>

                <xpath expr="//field[@name='invoice_date']" position="after">
                    <field name="x_force_payment_approved" 
                           widget="boolean_toggle"
                           groups="account.group_account_manager"
                           invisible="x_discrepancy_state != 'discrepancy'"/>
                </xpath>

                <xpath expr="//field[@name='invoice_line_ids']/list" position="attributes">
                    <attribute name="decoration-danger">is_3way_discrepancy</attribute>
                </xpath>

                <xpath expr="//field[@name='invoice_line_ids']/list/field[@name='price_unit']" position="after">
                    <field name="is_3way_discrepancy" invisible="1"/>
                    <field name="purchase_line_id" optional="hide"/>
                </xpath>

            </field>
        </record>
        
        <record id="view_invoice_tree_inherit_discrepancy" model="ir.ui.view">
            <field name="name">account.move.tree.discrepancy</field>
            <field name="model">account.move</field>
            <field name="inherit_id" ref="account.view_invoice_tree"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='status_in_payment']" position="before">
                     <field name="x_discrepancy_state" widget="badge"
                           decoration-danger="x_discrepancy_state == 'discrepancy'"
                           decoration-success="x_discrepancy_state == 'clean'"
                           optional="show"/>
                </xpath>
            </field>
        </record>

        <record id="view_account_invoice_filter_inherit_discrepancy" model="ir.ui.view">
            <field name="name">account.invoice.select.discrepancy</field>
            <field name="model">account.move</field>
            <field name="inherit_id" ref="account.view_account_invoice_filter"/>
            <field name="arch" type="xml">
                <xpath expr="//filter[@name='closed']" position="after">
                    <separator/>
                    <filter string="Con Discrepancias (3-Way)" name="discrepancy_filter" 
                            domain="[('x_discrepancy_state', '=', 'discrepancy')]"/>
                    <separator/>
                </xpath>
            </field>
        </record>

    </data>
</odoo>