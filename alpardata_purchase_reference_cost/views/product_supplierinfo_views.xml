<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ══════════════════════════════════════════════════════════════════════
         Herencia: formulario individual de supplierinfo
         Agrega campo "Costo de Referencia" y smart button de historial
    ═══════════════════════════════════════════════════════════════════════ -->
    <record id="view_product_supplierinfo_form_reference_cost" model="ir.ui.view">
        <field name="name">product.supplierinfo.form.reference.cost</field>
        <field name="model">product.supplierinfo</field>
        <field name="inherit_id" ref="product.product_supplierinfo_form_view"/>
        <field name="arch" type="xml">

            <!-- product.product_supplierinfo_form_view no define un button_box
                 (ni en 18 ni en 19), asi que lo creamos como primer hijo del
                 sheet, que es donde Odoo espera encontrarlo. -->
            <xpath expr="//sheet/group" position="before">
                <div class="oe_button_box" name="button_box">
                <button name="action_view_supplierinfo_cost_history"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-history"
                        groups="purchase.group_purchase_manager">
                    <field name="supplierinfo_cost_history_count"
                           widget="statinfo"
                           string="Historial"/>
                </button>
                </div>
            </xpath>

            <xpath expr="//field[@name='price']/.." position="after">
                <label for="reference_cost" string="Costo de Referencia"
                       groups="purchase.group_purchase_manager"/>
                <div groups="purchase.group_purchase_manager">
                    <field name="reference_cost" class="oe_inline"/>
                </div>
            </xpath>

        </field>
    </record>

    <!-- ══════════════════════════════════════════════════════════════════════
         Herencia: lista inline de proveedores en la pestaña Compras
         Agrega columna "Costo Ref." después de "Price"
    ═══════════════════════════════════════════════════════════════════════ -->
    <record id="view_product_supplierinfo_list_inline_reference_cost" model="ir.ui.view">
        <field name="name">product.supplierinfo.list.inline.reference.cost</field>
        <field name="model">product.supplierinfo</field>
        <field name="inherit_id" ref="purchase.product_supplierinfo_tree_view2"/>
        <field name="arch" type="xml">

            <xpath expr="//field[@name='price']" position="after">
                <field name="reference_cost"
                       string="Costo Ref."
                       optional="show"
                       groups="purchase.group_purchase_manager"/>
            </xpath>

        </field>
    </record>

    <!-- ══════════════════════════════════════════════════════════════════════
         Vista lista global de product.supplierinfo con reference_cost
         Accesible desde Compras > Costos de Referencia > Precios por Proveedor
    ═══════════════════════════════════════════════════════════════════════ -->
    <record id="view_product_supplierinfo_list_reference_cost" model="ir.ui.view">
        <field name="name">product.supplierinfo.list.reference.cost</field>
        <field name="model">product.supplierinfo</field>
        <field name="arch" type="xml">
            <list string="Precios de Referencia por Proveedor"
                  decoration-muted="reference_cost == 0">
                <field name="partner_id" string="Proveedor"/>
                <field name="product_tmpl_id" string="Producto"/>
                <field name="product_code" string="Código proveedor" optional="show"/>
                <field name="price" string="Precio de compra" widget="monetary"/>
                <field name="reference_cost"
                       string="Costo de Referencia"
                       widget="monetary"/>
                <field name="currency_id" column_invisible="True"/>
                <field name="sequence" optional="show"/>
                <field name="date_start" optional="show"/>
                <field name="date_end" optional="show"/>
                <field name="company_id" groups="base.group_multi_company" optional="show"/>
            </list>
        </field>
    </record>

    <record id="action_product_supplierinfo_reference_cost" model="ir.actions.act_window">
        <field name="name">Precios de Referencia por Proveedor</field>
        <field name="res_model">product.supplierinfo</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="view_product_supplierinfo_list_reference_cost"/>
        <field name="domain">[('reference_cost', '>', 0)]</field>
        <field name="group_ids" eval="[(4, ref('purchase.group_purchase_manager'))]"/>
    </record>

</odoo>
