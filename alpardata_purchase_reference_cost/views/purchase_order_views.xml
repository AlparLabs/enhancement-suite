<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Agrega Costo de referencia en las líneas de la orden de compra -->
    <record id="purchase_order_line_reference_cost_tree" model="ir.ui.view">
        <field name="name">purchase.order.form.line.reference_cost</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='order_line']/list/field[@name='price_unit']" position="after">
                <field name="reference_cost" optional="show" readonly="1"/>
            </xpath>
        </field>
    </record>

</odoo>
