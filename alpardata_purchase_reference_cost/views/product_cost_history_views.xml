<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ══════════════════════════════════════════════════════════════════════
         product.cost.history — VISTA LIST (solo lectura, no hay form editable)
    ═══════════════════════════════════════════════════════════════════════ -->
    <record id="view_product_cost_history_list" model="ir.ui.view">
        <field name="name">product.cost.history.list</field>
        <field name="model">product.cost.history</field>
        <field name="arch" type="xml">
            <list string="Historial de Costo de Referencia"
                  create="false"
                  edit="false"
                  delete="false"
                  default_order="change_date desc">
                <field name="change_date" string="Fecha"/>
                <field name="product_tmpl_id" string="Producto"/>
                <field name="product_categ_id" string="Categoría"/>
                <field name="old_reference_cost"
                       string="Costo anterior"
                       widget="monetary"/>
                <field name="new_reference_cost"
                       string="Nuevo costo"
                       widget="monetary"/>
                <field name="variation_pct"
                       string="Variación %"
                       decoration-danger="variation_pct &gt; 20"
                       decoration-warning="variation_pct &gt; 10 and variation_pct &lt;= 20"
                       decoration-success="variation_pct &gt; 0 and variation_pct &lt;= 10"/>
                <field name="changed_by" string="Modificado por"/>
                <field name="change_reason" string="Motivo" optional="show"/>
                <field name="company_id"
                       groups="base.group_multi_company"
                       string="Empresa"
                       optional="show"/>
            </list>
        </field>
    </record>

    <!-- ══════════════════════════════════════════════════════════════════════
         product.cost.history — VISTA SEARCH
    ═══════════════════════════════════════════════════════════════════════ -->
    <record id="view_product_cost_history_search" model="ir.ui.view">
        <field name="name">product.cost.history.search</field>
        <field name="model">product.cost.history</field>
        <field name="arch" type="xml">
            <search string="Buscar historial de costos">
                <field name="product_tmpl_id" string="Producto"/>
                <field name="product_categ_id" string="Categoría"/>
                <field name="changed_by" string="Modificado por"/>
                <group expand="0" string="Agrupar por">
                    <filter name="group_by_product"
                            string="Producto"
                            context="{'group_by': 'product_tmpl_id'}"/>
                    <filter name="group_by_month"
                            string="Mes"
                            context="{'group_by': 'change_date:month'}"/>
                    <filter name="group_by_user"
                            string="Usuario"
                            context="{'group_by': 'changed_by'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- ══════════════════════════════════════════════════════════════════════
         product.cost.history — VISTA GRAPH (evolución de costos)
    ═══════════════════════════════════════════════════════════════════════ -->
    <record id="view_product_cost_history_graph" model="ir.ui.view">
        <field name="name">product.cost.history.graph</field>
        <field name="model">product.cost.history</field>
        <field name="arch" type="xml">
            <graph string="Evolución de Costos de Referencia"
                   type="line">
                <field name="change_date" type="row"/>
                <field name="new_reference_cost" type="measure"/>
            </graph>
        </field>
    </record>

    <!-- ══════════════════════════════════════════════════════════════════════
         ACCIÓN DE VENTANA — product.cost.history
    ═══════════════════════════════════════════════════════════════════════ -->
    <record id="action_product_cost_history" model="ir.actions.act_window">
        <field name="name">Historial de Costos de Referencia</field>
        <field name="res_model">product.cost.history</field>
        <field name="view_mode">list,graph</field>
        <field name="search_view_id" ref="view_product_cost_history_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Sin historial de cambios registrado
            </p>
            <p>
                Aquí aparecerá un registro de cada vez que se modifique
                el <strong>Costo de Referencia</strong> de un producto,
                ya sea manualmente o a través de una programación de costo.
            </p>
        </field>
    </record>

</odoo>
