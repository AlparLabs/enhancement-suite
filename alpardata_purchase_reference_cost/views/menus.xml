<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ══════════════════════════════════════════════════════════════════════
         Menús bajo Compras ▸ Costos de Referencia
    ═══════════════════════════════════════════════════════════════════════ -->

    <!-- Menú principal: Costos de Referencia (sub-menú de Compras) -->
    <menuitem id="menu_reference_cost_root"
              name="Costos de Referencia"
              parent="purchase.menu_purchase_root"
              sequence="30"
              groups="purchase.group_purchase_manager"/>

    <!-- Programaciones de costo -->
    <menuitem id="menu_product_cost_schedule"
              name="Programaciones de Costo"
              parent="menu_reference_cost_root"
              action="action_product_cost_schedule"
              sequence="10"
              groups="purchase.group_purchase_manager"/>

    <!-- Historial de cambios -->
    <menuitem id="menu_product_cost_history"
              name="Historial de Cambios"
              parent="menu_reference_cost_root"
              action="action_product_cost_history"
              sequence="20"
              groups="purchase.group_purchase_manager"/>

    <!-- Actualización masiva (wizard) -->
    <menuitem id="menu_reference_cost_mass_update"
              name="Actualización Masiva"
              parent="menu_reference_cost_root"
              action="action_product_reference_cost_mass_update"
              sequence="30"
              groups="purchase.group_purchase_manager"/>

    <!-- Importar lista de precios de proveedor -->
    <menuitem id="menu_supplier_pricelist_import"
              name="Importar Lista de Precios"
              parent="menu_reference_cost_root"
              action="action_supplier_pricelist_import"
              sequence="40"
              groups="purchase.group_purchase_manager"/>

    <!-- Precios por proveedor (supplierinfo con reference_cost) -->
    <menuitem id="menu_product_supplierinfo_reference_cost"
              name="Precios por Proveedor"
              parent="menu_reference_cost_root"
              action="action_product_supplierinfo_reference_cost"
              sequence="50"
              groups="purchase.group_purchase_manager"/>

    <!-- Historial de precios por proveedor -->
    <menuitem id="menu_supplierinfo_cost_history"
              name="Historial de Precios por Proveedor"
              parent="menu_reference_cost_root"
              action="action_supplierinfo_cost_history"
              sequence="60"
              groups="purchase.group_purchase_manager"/>

</odoo>
