<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ── Cron: aplicar programaciones de costo de referencia ─────────────── -->
    <record id="ir_cron_apply_scheduled_costs" model="ir.cron">
        <field name="name">AlparData: Aplicar programaciones de Costo de Referencia</field>
        <field name="model_id" ref="model_product_cost_schedule"/>
        <field name="state">code</field>
        <field name="code">model._cron_apply_scheduled_costs()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="numbercall">-1</field>
        <field name="active">True</field>
        <field name="user_id" ref="base.user_root"/>
        <field name="priority">10</field>
    </record>

</odoo>
