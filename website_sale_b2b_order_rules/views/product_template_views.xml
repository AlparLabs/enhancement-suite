<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="product_template_form_view_inherit_b2b_limits" model="ir.ui.view">
        <field name="name">product.template.form.inherit.b2b.limits</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Regulación B2B" name="b2b_regulation">
                    <field name="b2b_order_limit_ids">
                        <list editable="bottom">
                            <field name="name" placeholder="ej. Permanente, Pascua, Invierno"/>
                            <field name="website_id" options="{'no_create': True}"/>
                            <field name="date_from"/>
                            <field name="date_to"/>
                            <field name="week_number"/>
                            <field name="max_qty"/>
                            <field name="min_qty"/>
                        </list>
                    </field>
                    <div class="text-muted mt-2 small">
                        <i class="fa fa-info-circle me-1"/>
                        Defina los cupos máximos y/o mínimos por pedido para cada canal web. Puede configurar reglas permanentes (sin fechas) o reglas estacionales/especiales por rango de fechas o número de semana. Si un producto no tiene reglas cargadas, se vende libremente sin límites.
                    </div>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
