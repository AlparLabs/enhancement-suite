<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="product_template_form_view_inherit_b2b_limits" model="ir.ui.view">
        <field name="name">product.template.form.inherit.b2b.limits</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Regulación B2B" name="b2b_regulation">
                    <field name="b2b_order_limit_ids">
                        <list editable="bottom">
                            <field name="website_id" options="{'no_create': True}"/>
                            <field name="max_qty"/>
                            <field name="min_qty"/>
                        </list>
                    </field>
                    <div class="text-muted mt-2">
                        <i class="fa fa-info-circle me-1"/>
                        Defina la cantidad máxima y/o mínima permitida por pedido para cada canal web (Franquicias, Distribución, etc.). Ingrese 0 para dejar sin límite.
                    </div>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
