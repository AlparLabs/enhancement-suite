<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="quick_order_page" name="B2B Quick Order Page">
        <t t-call="website.layout">
            <div id="wrap" class="container py-4">
                <div class="d-flex flex-wrap justify-content-between align-items-center mb-3">
                    <div>
                        <h2 class="fw-bold mb-0">
                            <i class="fa fa-th-list me-2 text-primary"/>Planilla de Pedido Rápido B2B
                        </h2>
                        <span class="text-muted small">Canal activo: <strong><t t-out="website.name"/></strong></span>
                    </div>
                    <a href="/shop" class="btn btn-outline-secondary btn-sm">
                        <i class="fa fa-arrow-left me-1"/> Ver Catálogo Tradicional
                    </a>
                </div>

                <!-- Alerta si el horario está cerrado -->
                <t t-if="website.b2b_order_schedule_active and not is_day_allowed">
                    <div class="alert alert-warning mb-4 shadow-sm border-warning" role="alert">
                        <i class="fa fa-calendar-times-o fa-2x me-3 text-warning float-start"/>
                        <div>
                            <strong>Toma de pedidos cerrada en este momento</strong>
                            <div class="small">
                                Para el canal <strong><t t-out="website.name"/></strong>, los pedidos se reciben en los siguientes horarios: 
                                <strong><t t-out="website.b2b_allowed_days_display"/></strong>.
                            </div>
                        </div>
                    </div>
                </t>

                <!-- Alerta si el cliente presenta deuda -->
                <t t-if="financial_status and financial_status.get('is_blocked')">
                    <div class="alert alert-danger mb-4 shadow-sm border-danger" role="alert">
                        <i class="fa fa-ban fa-2x me-3 text-danger float-start"/>
                        <div>
                            <strong>Toma de pedidos suspendida por saldos pendientes</strong>
                            <div class="small">
                                Tu cuenta presenta facturas vencidas o límite superado. Consulta tu 
                                <a href="/my/account_statement/pdf" class="alert-link" target="_blank">Estado de Cuenta (PDF)</a> 
                                para regularizar tu situación.
                            </div>
                        </div>
                    </div>
                </t>

                <!-- Formulario de Pedido Rápido -->
                <form action="/shop/quick_order/add" method="POST">
                    <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>

                    <div class="card shadow-sm border-0 mb-4">
                        <div class="card-body p-0">
                            <div class="table-responsive">
                                <table class="table table-hover align-middle mb-0">
                                    <thead class="table-light">
                                        <tr>
                                            <th style="width: 70px;"></th>
                                            <th>Producto / Variedad</th>
                                            <th class="text-center" style="width: 120px;">Código</th>
                                            <th class="text-end" style="width: 140px;">Precio Unitario</th>
                                            <th class="text-center" style="width: 160px;">Cantidad a Pedir</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <t t-foreach="products" t-as="p">
                                            <t t-set="p_limit" t-value="p._get_b2b_order_limit_for_website(website)"/>
                                            <tr>
                                                <td class="text-center p-2">
                                                    <img t-attf-src="/web/image/product.template/#{p.id}/image_128"
                                                         class="rounded" style="max-height: 50px; max-width: 50px; object-fit: contain;"/>
                                                </td>
                                                <td>
                                                    <div class="fw-semibold text-dark"><t t-out="p.name"/></div>
                                                    <div class="small text-muted">
                                                        Unidad: <t t-out="p.uom_id.name"/>
                                                        <t t-if="p_limit and p_limit.max_qty &gt; 0">
                                                            <span class="badge text-bg-warning ms-1" title="Tope máximo por pedido">
                                                                Tope: <t t-out="int(p_limit.max_qty) if p_limit.max_qty.is_integer() else p_limit.max_qty"/>
                                                            </span>
                                                        </t>
                                                    </div>
                                                </td>
                                                <td class="text-center text-muted small">
                                                    <span t-out="p.default_code or '-'"/>
                                                </td>
                                                <td class="text-end fw-semibold">
                                                    <span t-out="pricelist._get_product_price(p, 1.0) if pricelist else p.list_price"
                                                          t-options="{'widget': 'monetary', 'display_currency': website.currency_id}"/>
                                                </td>
                                                <td class="text-center">
                                                    <t t-if="(website.b2b_order_schedule_active and not is_day_allowed) or (financial_status and financial_status.get('is_blocked'))">
                                                        <input type="text" class="form-control form-control-sm text-center disabled" disabled="disabled" value="0"/>
                                                    </t>
                                                    <t t-else="">
                                                        <input type="number"
                                                               t-attf-name="qty_#{p.product_variant_id.id}"
                                                               class="form-control form-control-sm text-center mx-auto"
                                                               style="max-width: 100px;"
                                                               min="0"
                                                               t-att-max="p_limit.max_qty if (p_limit and p_limit.max_qty &gt; 0) else None"
                                                               value="0"/>
                                                    </t>
                                                </td>
                                            </tr>
                                        </t>
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>

                    <!-- Botón de acción -->
                    <div class="d-flex justify-content-end align-items-center mb-5 gap-3">
                        <t t-if="(website.b2b_order_schedule_active and not is_day_allowed) or (financial_status and financial_status.get('is_blocked'))">
                            <button type="button" class="btn btn-secondary btn-lg disabled" disabled="disabled">
                                <i class="fa fa-ban me-2"/>Toma de Pedidos Inhabilitada
                            </button>
                        </t>
                        <t t-else="">
                            <button type="submit" class="btn btn-primary btn-lg shadow-sm">
                                <i class="fa fa-shopping-cart me-2"/>Cargar todo al Carrito
                            </button>
                        </t>
                    </div>
                </form>
            </div>
        </t>
    </template>

    <!-- Enlace directo en el header del catálogo (/shop) hacia la Planilla de Pedido Rápido -->
    <template id="products_quick_order_link" inherit_id="website_sale.products" name="B2B Quick Order Button in Shop">
        <xpath expr="//div[hasclass('o_wsale_products_main_row')]" position="before">
            <div class="d-flex justify-content-end mb-3">
                <a href="/shop/quick_order" class="btn btn-outline-primary btn-sm shadow-sm">
                    <i class="fa fa-th-list me-1"/> Planilla de Pedido Rápido B2B
                </a>
            </div>
        </xpath>
    </template>

</odoo>
