<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_website_form_inherit_b2b_order_rules" model="ir.ui.view">
        <field name="name">website.form.inherit.b2b.order.rules</field>
        <field name="model">website</field>
        <field name="inherit_id" ref="website.view_website_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='domain']" position="after">
                <group string="Ventana de Pedidos B2B (Días y Horarios)" name="b2b_order_schedule">
                    <field name="b2b_order_schedule_active"/>
                    <field name="b2b_allowed_days_display" readonly="1" invisible="not b2b_order_schedule_active"/>
                    <div colspan="2" invisible="not b2b_order_schedule_active" class="mt-2">
                        <field name="b2b_schedule_ids">
                            <list editable="bottom">
                                <field name="day_of_week"/>
                                <field name="hour_from" widget="float_time"/>
                                <field name="hour_to" widget="float_time"/>
                            </list>
                        </field>
                        <div class="text-muted small mt-1">
                            <i class="fa fa-info-circle me-1"/>
                            Configure los días y horarios permitidos para recibir pedidos en este canal (ej. Viernes de 08:00 a 13:00). Los días u horarios no incluidos permanecerán cerrados para compras.
                        </div>
                    </div>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
