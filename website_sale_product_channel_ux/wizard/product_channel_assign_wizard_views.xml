<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Wizard Form View -->
    <record id="view_product_channel_assign_wizard_form" model="ir.ui.view">
        <field name="name">product.channel.assign.wizard.form</field>
        <field name="model">product.channel.assign.wizard</field>
        <field name="arch" type="xml">
            <form string="Asignar Canal Web a Productos">
                <sheet>
                    <p class="text-muted mb-3">
                        Actualice masivamente la disponibilidad de los productos seleccionados en las plataformas de comercio electrónico (Franquicias / Distribución).
                    </p>
                    <group>
                        <group string="Configuración de Destino">
                            <field name="action_type" widget="radio"/>
                            <field name="website_id"
                                   invisible="action_type != 'assign'"
                                   required="action_type == 'assign'"
                                   options="{'no_create': True, 'no_open': True}"/>
                        </group>
                        <group string="Resumen">
                            <field name="product_count"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Productos Seleccionados" name="selected_products">
                            <field name="product_tmpl_ids" readonly="1">
                                <list>
                                    <field name="default_code" optional="show"/>
                                    <field name="name"/>
                                    <field name="website_id" string="Canal Actual"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <footer>
                    <button name="action_apply"
                            string="Aplicar Asignación"
                            type="object"
                            class="btn-primary"/>
                    <button string="Cancelar"
                            class="btn-secondary"
                            special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Action bound to product.template list view -->
    <record id="action_product_channel_assign_wizard" model="ir.actions.act_window">
        <field name="name">Asignar Canal Web</field>
        <field name="res_model">product.channel.assign.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="view_id" ref="view_product_channel_assign_wizard_form"/>
        <field name="binding_model_id" ref="product.model_product_template"/>
        <field name="binding_view_types">list</field>
    </record>

    <!-- Action bound to product.product list view -->
    <record id="action_product_variant_channel_assign_wizard" model="ir.actions.act_window">
        <field name="name">Asignar Canal Web</field>
        <field name="res_model">product.channel.assign.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="view_id" ref="view_product_channel_assign_wizard_form"/>
        <field name="binding_model_id" ref="product.model_product_product"/>
        <field name="binding_view_types">list</field>
    </record>

</odoo>
