<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        Agrega los campos de mínimo de compra en la sección "Compra" de la
        pestaña "Ventas y Compras" del formulario de contacto. El grupo
        name="purchase" lo define account.view_partner_property_form (moneda de
        compra, condiciones de pago del proveedor, etc.), que es el lugar
        natural para la configuración de compras del proveedor.
    -->
    <record id="view_partner_form_purchase_minimum" model="ir.ui.view">
        <field name="name">res.partner.form.purchase.minimum</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="purchase.view_partner_property_form"/>
        <field name="arch" type="xml">

            <xpath expr="//group[@name='purchase']" position="inside">
                <field name="apply_purchase_minimum"/>
                <field
                    name="purchase_minimum_amount"
                    invisible="not apply_purchase_minimum"
                />
            </xpath>

        </field>
    </record>
</odoo>
