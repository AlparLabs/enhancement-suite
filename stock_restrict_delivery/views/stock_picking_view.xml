<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_picking_form_restrict_invoice" model="ir.ui.view">
        <field name="name">stock.picking.form.restrict.invoice</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">
            
            <xpath expr="//page[@name='extra']//group" position="inside">
                <group string="Autorización Gerencial" 
                       groups="stock_restrict_delivery.group_manager_force_delivery">
                    <field name="force_no_invoice_delivery" widget="boolean_toggle"/>
                </group>
            </xpath>

        </field>
    </record>
</odoo>