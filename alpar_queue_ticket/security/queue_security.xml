<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record model="ir.module.category" id="module_category_alpar_queue">
        <field name="name">Gestión de Turnos</field>
        <field name="description">Control y asignación de turnos para POS y Ventas</field>
        <field name="sequence">25</field>
    </record>

    <record id="res_groups_privilege_alpar_queue" model="res.groups.privilege">
        <field name="name">Gestión de Turnos</field>
        <field name="description">Control y asignación de turnos para POS y Ventas</field>
        <field name="category_id" ref="module_category_alpar_queue"/>
        <field name="sequence">10</field>
    </record>

    <record id="group_queue_user" model="res.groups">
        <field name="name">Operador de Turnos</field>
        <field name="privilege_id" ref="res_groups_privilege_alpar_queue"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_queue_manager" model="res.groups">
        <field name="name">Administrador de Turnos</field>
        <field name="privilege_id" ref="res_groups_privilege_alpar_queue"/>
        <field name="implied_ids" eval="[(4, ref('group_queue_user'))]"/>
    </record>

    <record id="rule_queue_ticket_multicompany" model="ir.rule">
        <field name="name">Turnos Multi-compañía</field>
        <field name="model_id" ref="model_queue_ticket"/>
        <field name="global" eval="True"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>

    <record id="rule_queue_ticket_type_multicompany" model="ir.rule">
        <field name="name">Tipos de Turnos Multi-compañía</field>
        <field name="model_id" ref="model_queue_ticket_type"/>
        <field name="global" eval="True"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
