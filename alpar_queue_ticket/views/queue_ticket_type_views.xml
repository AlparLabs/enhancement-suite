<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- FORM VIEW -->
    <record id="view_queue_ticket_type_form" model="ir.ui.view">
        <field name="name">queue.ticket.type.form</field>
        <field name="model">queue.ticket.type</field>
        <field name="arch" type="xml">
            <form string="Tipo de Turno">
                <sheet>
                    <widget name="web_ribbon" title="Archivado" bg_color="text-bg-danger" invisible="active"/>
                    <div class="oe_title">
                        <label for="name" string="Nombre de la Categoría / Cola"/>
                        <h1>
                            <field name="name" placeholder="Ej: Caja / Cobros, Ventas, Retiro..."/>
                        </h1>
                    </div>
                    <group>
                        <group string="Identificación y Prefijo">
                            <field name="code" placeholder="ej: caja, ventas, pickup"/>
                            <field name="prefix" placeholder="ej: C, V, R"/>
                            <field name="sequence"/>
                            <field name="active" widget="boolean_toggle"/>
                        </group>
                        <group string="Diseño para Pantallas y Kiosco">
                            <field name="icon" placeholder="ej: fa-shopping-cart, fa-briefcase"/>
                            <field name="color" widget="color" placeholder="#3498db"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <group string="Descripción para el Cliente (Kiosco Android)">
                        <field name="description" nolabel="1" placeholder="Texto explicativo para el cliente que aparecerá en el botón de la terminal..."/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- LIST VIEW -->
    <record id="view_queue_ticket_type_tree" model="ir.ui.view">
        <field name="name">queue.ticket.type.list</field>
        <field name="model">queue.ticket.type</field>
        <field name="arch" type="xml">
            <list string="Tipos de Turnos">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="code"/>
                <field name="prefix" decoration-bf="1"/>
                <field name="icon"/>
                <field name="color" widget="color"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <!-- SEARCH VIEW -->
    <record id="view_queue_ticket_type_search" model="ir.ui.view">
        <field name="name">queue.ticket.type.search</field>
        <field name="model">queue.ticket.type</field>
        <field name="arch" type="xml">
            <search string="Buscar Tipos de Turnos">
                <field name="name" string="Nombre"/>
                <field name="code" string="Código"/>
                <field name="prefix" string="Prefijo"/>
                <separator/>
                <filter string="Archivados" name="inactive" domain="[('active', '=', False)]"/>
            </search>
        </field>
    </record>

    <!-- ACTION -->
    <record id="action_queue_ticket_type" model="ir.actions.act_window">
        <field name="name">Tipos de Turnos</field>
        <field name="res_model">queue.ticket.type</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Crea un nuevo tipo o categoría de turno para tus salas de espera y terminales Kiosco.
            </p>
        </field>
    </record>

</odoo>
