<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="pos_config_view_form_inherit_queue" model="ir.ui.view">
        <field name="name">pos.config.form.inherit.queue</field>
        <field name="model">pos.config</field>
        <field name="inherit_id" ref="point_of_sale.pos_config_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="inside">
                <h2>Gestión de Turnos</h2>
                <div class="row mt16 o_settings_container">
                    <div class="col-12 col-lg-6 o_setting_box">
                        <div class="o_setting_right_pane">
                            <label for="queue_type_id" string="Cola de Turnos Asignada"/>
                            <div class="text-muted">
                                Tipo de turno que llama y atiende prioritariamente esta caja POS
                            </div>
                            <field name="queue_type_id"/>
                        </div>
                    </div>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
