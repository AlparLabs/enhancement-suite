<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        El próximo número libre de la chequera se publica en el contexto de la
        One2many de cheques. Así `default_get` puede numerar la línea nueva
        apenas se agrega, teniendo en cuenta las que ya están cargadas en el
        cliente y todavía no se guardaron. Sin esto cada línea nueva nacería
        con el contador del diario, que no avanza hasta postear el pago, y
        todas quedarían con el mismo número.
    -->
    <record id="view_account_payment_form_check_sequence" model="ir.ui.view">
        <field name="name">account.payment.form.check.sequence</field>
        <field name="model">account.payment</field>
        <field name="inherit_id" ref="l10n_latam_check.view_account_payment_form_inherited"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='l10n_latam_new_check_ids']" position="before">
                <field name="check_sequence_next_number" invisible="1"/>
            </xpath>
            <xpath expr="//field[@name='l10n_latam_new_check_ids']" position="attributes">
                <attribute name="context">{'check_sequence_next_number': check_sequence_next_number}</attribute>
            </xpath>
        </field>
    </record>

    <record id="view_account_payment_register_form_check_sequence" model="ir.ui.view">
        <field name="name">account.payment.register.form.check.sequence</field>
        <field name="model">account.payment.register</field>
        <field name="inherit_id" ref="l10n_latam_check.view_account_payment_register_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='l10n_latam_new_check_ids']" position="before">
                <field name="check_sequence_next_number" invisible="1"/>
            </xpath>
            <xpath expr="//field[@name='l10n_latam_new_check_ids']" position="attributes">
                <attribute name="context">{'check_sequence_next_number': check_sequence_next_number}</attribute>
            </xpath>
        </field>
    </record>
</odoo>
