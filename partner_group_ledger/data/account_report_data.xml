<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="partner_group_ledger_report" model="account.report">
        <field name="name">Partner Group Ledger</field>
        <field name="filter_journals" eval="True"/>
        <field name="filter_date_range" eval="True"/>
        <field name="filter_unfold_all" eval="True"/>
        <field name="filter_partner" eval="True"/>
        <field name="search_bar" eval="True"/>
        <field name="load_more_limit" eval="80"/>
        
        <field name="column_ids">
            <record id="column_partner_group_initial_balance" model="account.report.column">
                <field name="name">Initial Balance</field>
                <field name="expression_label">initial_balance</field>
                <field name="figure_type">monetary</field>
            </record>
            <record id="column_partner_group_debit" model="account.report.column">
                <field name="name">Debit</field>
                <field name="expression_label">debit</field>
                <field name="figure_type">monetary</field>
            </record>
            <record id="column_partner_group_credit" model="account.report.column">
                <field name="name">Credit</field>
                <field name="expression_label">credit</field>
                <field name="figure_type">monetary</field>
            </record>
            <record id="column_partner_group_balance" model="account.report.column">
                <field name="name">Balance</field>
                <field name="expression_label">balance</field>
                <field name="figure_type">monetary</field>
            </record>
        </field>

        <field name="line_ids">
            <record id="line_partner_group_root" model="account.report.line">
                <field name="name">Partner Groups</field>
                <field name="groupby">partner_group_id</field>
                <field name="foldable" eval="True"/>
                <field name="expression_ids">
                    <record id="expr_partner_group_initial_balance" model="account.report.expression">
                        <field name="label">initial_balance</field>
                        <field name="engine">aggregation</field>
                        <field name="formula">balance</field>
                        <field name="date_scope">previous</field>
                    </record>
                    <record id="expr_partner_group_debit" model="account.report.expression">
                        <field name="label">debit</field>
                        <field name="engine">aggregation</field>
                        <field name="formula">debit</field>
                        <field name="date_scope">strict_range</field>
                    </record>
                    <record id="expr_partner_group_credit" model="account.report.expression">
                        <field name="label">credit</field>
                        <field name="engine">aggregation</field>
                        <field name="formula">credit</field>
                        <field name="date_scope">strict_range</field>
                    </record>
                    <record id="expr_partner_group_balance" model="account.report.expression">
                        <field name="label">balance</field>
                        <field name="engine">aggregation</field>
                        <field name="formula">balance</field>
                        <field name="date_scope">normal</field>
                    </record>
                </field>
                <field name="children_ids">
                    <record id="line_partner_group_partner" model="account.report.line">
                        <field name="name">Partners</field>
                        <field name="groupby">partner_id</field>
                        <field name="foldable" eval="True"/>
                    </record>
                </field>
            </record>
        </field>
    </record>

    <!-- Menu item for the report -->
    <record id="action_partner_group_ledger_report" model="ir.actions.client">
        <field name="name">Partner Group Ledger</field>
        <field name="tag">account_report</field>
        <field name="context" eval="{'report_id': ref('partner_group_ledger_report')}"/>
    </record>

    <menuitem id="menu_partner_group_ledger_report" 
              name="Partner Group Ledger" 
              action="action_partner_group_ledger_report" 
              parent="account.menu_finance_reports" 
              sequence="25"/>
</odoo>
