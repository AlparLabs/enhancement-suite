<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="partner_objective_view_tree" model="ir.ui.view">
        <field name="name">partner.objective.tree</field>
        <field name="model">partner.objective</field>
        <field name="arch" type="xml">
            <list string="Objectives">
                <field name="date"/>
                <field name="date_end"/>
                <field name="partner_id"/>
                <field name="delivery_address_id"/>
                <field name="objective_qty"/>
                <field name="dozens_sold"/>
                <field name="dozens_remaining" optional="hide"/>
                <field name="dozens_achievement_pct" widget="progressbar"/>
                <field name="dozens_achieved"/>
                <field name="objective" optional="hide"/>
                <field name="currency_id" optional="hide"/>
                <field name="company_id" optional="hide" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="partner_objective_view_form" model="ir.ui.view">
        <field name="name">partner.objective.form</field>
        <field name="model">partner.objective</field>
        <field name="arch" type="xml">
            <form string="Objective">
                <sheet>
                    <group>
                        <group>
                            <field name="partner_id"/>
                            <field name="delivery_address_id"/>
                        </group>
                        <group>
                            <field name="date"/>
                            <field name="date_end"/>
                            <field name="objective_qty"/>
                            <field name="dozens_sold"/>
                            <field name="dozens_remaining"/>
                            <field name="dozens_achievement_pct" widget="progressbar"/>
                            <field name="dozens_achieved"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_partner_objective" model="ir.actions.act_window">
        <field name="name">Partner Objectives</field>
        <field name="res_model">partner.objective</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_partner_objective_root"
              name="Partner Objectives"
              parent="contacts.menu_contacts"
              action="action_partner_objective"
              sequence="30"/>

</odoo>
