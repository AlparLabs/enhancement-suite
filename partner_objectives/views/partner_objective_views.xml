<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="partner_objective_view_tree" model="ir.ui.view">
        <field name="name">partner.objective.tree</field>
        <field name="model">partner.objective</field>
        <field name="arch" type="xml">
            <list string="Objectives">
                <field name="date"/>
                <field name="partner_id"/>
                <field name="delivery_address_id"/>
                <field name="objective"/>
                <field name="currency_id" optional="hide"/>
                <field name="objective_qty"/>
                <field name="company_id" optional="hide" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="partner_objective_view_form" model="ir.ui.view">
        <field name="name">partner.objective.form</field>
        <field name="model">partner.objective</field>
        <field name="arch" type="xml">
            <form string="Objective">
                <sheet>
                    <group>
                        <group>
                            <field name="partner_id"/>
                            <field name="delivery_address_id"/>
                        </group>
                        <group>
                            <field name="date"/>
                            <field name="objective"/>
                            <field name="currency_id"/>
                            <field name="objective_qty"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="partner_objective_view_search" model="ir.ui.view">
        <field name="name">partner.objective.search</field>
        <field name="model">partner.objective</field>
        <field name="arch" type="xml">
            <search string="Objectives">
                <field name="partner_id"/>
                <field name="delivery_address_id"/>
                <filter string="This Year" name="this_year"
                        domain="[('date', '>=', (context_today().replace(month=1, day=1)).strftime('%Y-%m-%d'))]"/>
                <filter string="This Month" name="this_month"
                        domain="[('date', '&gt;=', (context_today().replace(day=1)).strftime('%Y-%m-%d'))]"/>
                <group expand="0" string="Group By">
                    <filter string="Partner" name="group_partner" context="{'group_by': 'partner_id'}"/>
                    <filter string="Date" name="group_date" context="{'group_by': 'date:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_partner_objective" model="ir.actions.act_window">
        <field name="name">Partner Objectives</field>
        <field name="res_model">partner.objective</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="partner_objective_view_search"/>
    </record>

    <menuitem id="menu_partner_objective_root"
              name="Partner Objectives"
              parent="base.menu_contacts"
              action="action_partner_objective"
              sequence="30"/>

</odoo>
