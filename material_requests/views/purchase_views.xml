<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_purchase_order_tree" model="ir.ui.view">
        <field name="name">purchase.order.list</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_view_tree"/>
        <field name="arch" type="xml">
            
            <field name="partner_id" position="after">
                <field name="pim_id" optional="show" widget="badge" 
                       decoration-danger="pim_id != False"/>
            </field>
            <field name="partner_id" position="after">
                <field name="sim_id" optional="show" widget="badge" 
                       decoration-danger="sim_id != False"/>
            </field>

            <list position="attributes">
                <attribute name="decoration-info">pim_id != False</attribute>
                <attribute name="decoration-info">sim_id != False</attribute>
            </list>

        </field>
    </record>
</odoo>